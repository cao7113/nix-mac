# 执行软链接步骤
cmd_link() {
	local repo_path="$1"
	local app_name="$2"

	local mix_env="prod"
	local builder_app_path="$repo_path/_build/$mix_env/_builder/_build/$mix_env/rel/$app_name"
	local target_app_path="$repo_path/_build/$mix_env/_app"

	if [[ ! -d "$builder_app_path" ]]; then
		echo "Error: Built release path does not exist: $builder_app_path" >&2
		echo "Please run 'build' command first." >&2
		return 1
	fi

	echo "🔗 创建/更新部署软链接..."
	ln -snf "$builder_app_path" "$target_app_path"
	echo "✨ 部署链接成功！"
	echo "   Target app path: $target_app_path"
	echo "   Linked to:       $builder_app_path"

	# 读取并显示部署的应用元数据
	local build_info_file="$target_app_path/.build_info"
	if [[ -f "$build_info_file" ]]; then
		echo ""
		echo "📋 当前部署版本元信息 (.build_info):"
		inspect_build_info "$build_info_file" "   "
	fi
}

main() {
	local sub_cmd="${1:-}"

	# 1. 无参数或请求帮助：尽早拦截并退出
	if [[ -z "$sub_cmd" || "$sub_cmd" == "-h" || "$sub_cmd" == "--help" || "$sub_cmd" == "h" || "$sub_cmd" == "help" ]]; then
		usage
		if [[ -n "$sub_cmd" ]]; then
			return 0
		else
			return 1
		fi
	fi

	# 检查环境命令依赖及 Elixir 版本
	check_dependencies || return 1

	shift

	# 2. 解析后续选项（如 -f/--force）与 repo-path
	local force_flag=0
	local repo_path=""

	while [[ $# -gt 0 ]]; do
		case "$1" in
		-f | --force)
			force_flag=1
			shift
			;;
		*)
			if [[ -z "$repo_path" ]]; then
				repo_path="$1"
			fi
			shift
			;;
		esac
	done

	local default_path
	default_path=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

	repo_path="${repo_path:-$default_path}"
	repo_path="${repo_path:A}" # 转换为绝对路径

	check_phoenix_project "$repo_path" || return 1

	# 3. 提取 Mix 应用名称
	local app_name
	app_name="$(get_app_name "$repo_path")"
	if [[ -z "$app_name" ]]; then
		echo "Error: Failed to fetch Phoenix application name from $repo_path" >&2
		return 1
	fi

	# 4. 根据具体子命令分流执行
	case "$sub_cmd" in
	a | appname)
		echo "$app_name"
		;;
	g | gen | tmpl)
		cmd_gen "$repo_path" "$app_name"
		;;
	s | status | i | info)
		cmd_status "$repo_path" "$app_name"
		;;
	b | build)
		cmd_build "$repo_path" "$app_name" "$force_flag"
		;;
	l | link)
		cmd_link "$repo_path" "$app_name"
		;;
	r | rel | deploy)
		cmd_build "$repo_path" "$app_name" "$force_flag"
		echo ""
		cmd_link "$repo_path" "$app_name"
		;;
	*)
		echo "Error: Unknown command '$sub_cmd'" >&2
		usage >&2
		return 1
		;;
	esac
}

main "$@"
