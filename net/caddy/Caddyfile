{
	# 1. 修改默认 Admin 接口，避免多实例冲突（可选）
	# admin localhost:2019

	pki {
		ca local {
			name "Caddy Local Lab Prod CA"
		}
	}

	# 2. 全局配置按需 TLS 授权校验接口
	on_demand_tls {
		ask http://127.0.0.1:9111
	}
}

# 内部鉴权放行接口：显式指定 http:// 避免触发 Auto-HTTPS，无条件返回 200 给 Caddy 放行
http://127.0.0.1:9111 {
	respond 200
}

# ------------------------------------------------------------------------------
# 静态固定测试域名 https://caddy.test.h
# ------------------------------------------------------------------------------
caddy.test.h {
	tls {
		issuer internal
	}
	respond "Caddy OK!"
}

# .s 域名：走 443 端口，由本地 CA 为具体单域名按需签发证书，解决通配符 *.s 被浏览器拒绝的问题
# *.s, *.*.s { ... }

# ------------------------------------------------------------------------------
# HTTPS (443): 接管所有未显式定义的 TLS 请求，走本地按需签发
# ------------------------------------------------------------------------------
:443 {
	tls {
		issuer internal
		on_demand
	}

	reverse_proxy localhost:8888
}

# ------------------------------------------------------------------------------
# HTTP (80): 显式接管明文流量，阻止默认的 Auto-HTTPS 全局 301 强制跳转
# ------------------------------------------------------------------------------
:80 {
	# .l 域名直接走反向代理（不跳转 HTTPS）
	@http_dev {
		header_regexp host Host (?i)^.*\.l$
	}
	reverse_proxy @http_dev localhost:8888

	# 其他 HTTP 流量可保留默认行为，或直接拒绝/跳转
	# handle {
	#     redir https://{host}{uri} permanent
	# }
}
