{
    # =========================================================================
    # 全局块 (Global Options)
    # 控制 Caddy 进程级别的底层引擎行为（PKI 证书颁发机构与 TLS 签发策略）
    # =========================================================================

    # 1. 自定义本地 PKI (Public Key Infrastructure) 根证书颁发机构
    # 原理：Caddy 内置了一个完整的 CA 引擎。此处自定义 CA 名称，在首次启动时，Caddy 会在本地
    # 自动生成 Root CA 证书与私钥（位于 Application Support/Caddy/pki/authorities/local/）。
    # 将此 Root CA 导入 macOS Keychain 并信任后，所有由该 CA 动态签发的本地单域名证书均会被系统与浏览器无缝信任。
    pki {
        ca local {
            name "Local Dev CA"
        }
    }

    # 2. 全局按需 TLS (On-Demand TLS) 鉴权配置
    # 原理：按需 TLS 允许 Caddy 在收到未知域名的 TLS Client Hello (SNI 握手) 时，现场“实时”签发证书。
    # 为了防止 DDoS 或恶意申请滥用（消耗系统资源/耗尽密钥存储），Caddy 强制要求在全局开启 on_demand_tls
    # 并指定一个 ask 端点。在握手阶段，Caddy 会先向该 URL 发起 HTTP GET 请求（附加 ?domain=xxx），
    # 只有当该端点响应 HTTP 200 OK 时，Caddy 的 TLS 引擎才会启动证书签发流程，否则直接中断握手。
    on_demand_tls {
        ask http://127.0.0.1:9111
    }
}

# =========================================================================
# 站点块 1: 极简放行服务 (Internal Ask Endpoint)
# 为 Caddy 内部的 TLS 鉴权逻辑提供 HTTP 200 放行信号
# =========================================================================

# 原理：显式声明为明文 `http://127.0.0.1:9111` 极其关键。
# 1) 加上 `http://` 前缀防止 Caddy 误认为这是 HTTPS 站点并为其自动申请/强制跳转 HTTPS。
# 2) 任何撞进 9111 端口的路径请求（如 `/` 或 `/?domain=xxx.s`），均无条件返回 200 OK。
# 这相当于在本地环境中完全信任所有的按需证书申请，彻底跳过外部复杂校验。
http://127.0.0.1:9111 {
    respond 200
}

# =========================================================================
# 站点块 2: HTTPS 按需 TLS 代理规则 (针对 .s TLD)
# 专接管所有以 .s 结尾的域名（包括单级与多级子域名，如 app.s, api.dev.s）
# =========================================================================

# 原理：
# 1) 域名匹配：`*.s, *.*.s` 限制了此规则块只捕获 .s 结尾的请求，避免侵入其他本地 TLD。
# 2) 客户端（如浏览器或 curl）拒绝 TLD 级别的通配符证书（例如 `*.s`），要求精确匹配具体域名（如 `app.s`）。
# 3) 借助 `tls { issuer internal; on_demand }`，当客户端通过 SNI 请求 `https://app.s` 时：
#    a. Caddy 拦截 TLS 握手，触发 on_demand；
#    b. 内部访问 http://127.0.0.1:9111 获得 200 放行；
#    c. 使用上面配置的 "Local Dev CA" 在毫秒级时间内为 `app.s` 现场签发一张单域名 SAN 证书；
#    d. 完成 TLS 握手并建立加密通道；
#    e. 将流量解密后反向代理至后端的 8888 端口。
*.s, *.*.s {
    tls {
        # 用 Caddy 自己内置的本地 CA 签发证书，不要去连接外部的 Let's Encrypt 或 ZeroSSL
        issuer internal
        # 传统模式：Caddy 启动时就会去把所有配置好的域名证书一次性申请完。但对于通配符 *.s，如果你在启动时申请，Caddy 会尝试去申请一张 *.s 的通配符证书。然而浏览器和 TLS 客户端是拒绝信任顶级域名通配符证书的（例如 *.s 或 *.com）。
        # 按需模式（on_demand）：Caddy 启动时不申请任何证书。只有当浏览器发起请求访问具体域名（例如 https://livebook.s 或 [https://api.test](https://api.test).s）并进行 TLS 握手的那一瞬间，Caddy 才会实时在毫秒级时间内为 livebook.s 这个具体的单域名动态签发一张专属证书。
        on_demand
    }

    reverse_proxy localhost:8888
}

# =========================================================================
# 站点块 3: 明文 HTTP 代理规则 (针对 .l TLD)
# 专接管所有以 .l 结尾的域名，强制仅走明文 HTTP (80 端口)
# =========================================================================

# 原理：
# 1) 显式加上 `http://` Scheme 是核心操作：默认情况下，如果仅写 `*.l`，Caddy 的 Auto-HTTPS 机制
#    会试图为该域名绑定 443 端口并强行将 HTTP 80 请求 301 重定向到 HTTPS 443。
# 2) 通过明确指定 `http://*.l, http://*.*.l`，直接通知 Caddy 禁用该域名块的 Auto-HTTPS 逻辑。
# 3) 此时发往 `http://app.l` 的请求将只在 80 端口进行明文 HTTP 处理与转发，完全不触发任何 TLS 握手或 PKI 流程。
http://*.l, http://*.*.l {
    reverse_proxy localhost:8888
}